# Copy this file to .env and fill it in. Never commit .env to Git.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/poolit
# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Only needed if the React app is hosted on a different address than the API
CLIENT_URL=

# Used once by `node src/seed.js` to create the chairperson. Remove CHAIR_PASSWORD afterwards.
CHAIR_NAME=
CHAIR_PHONE=
CHAIR_PASSWORD=

# ---- Text messages (SMS) via Africa's Talking: https://africastalking.com ----
SMS_PROVIDER=africastalking
# Use the username "sandbox" and your sandbox API key to practise without sending real messages
AT_USERNAME=
AT_API_KEY=
# Optional alphanumeric sender name (must be registered with Africa's Talking first)
AT_SENDER_ID=
# Long random text. Put the same text in the delivery-report address (see GO-LIVE.md)
SMS_WEBHOOK_SECRET=
# Send contribution and loan reminders automatically at 8:00 am Nairobi time. Use "off" to disable.
SMS_REMINDERS=on
